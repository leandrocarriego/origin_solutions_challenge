# Copiar a .env y completar. Nada de esto se versiona (SEC-01, SEC-03).

# --- Obligatorias en producción ---------------------------------------------
DOMAIN=origin-solutions-challenge.mendrisoftware.com
POSTGRES_PASSWORD=

# --- El proveedor -----------------------------------------------------------
# Vacía hasta la fase 1: la página de health no la usa. El módulo quotes falla
# explícitamente si la necesita y no está (Artículo I: nunca en una VITE_*).
TWELVEDATA_API_KEY=

# --- Observabilidad (ADR-009) -----------------------------------------------
# Vacío desactiva Sentry, que es lo que quieren local y CI: sin eventos, sin red.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Sello del build. El script de deploy lo completa con el SHA del commit.
VERSION=dev

# --- Observabilidad capa 3: Grafana (ADR-009) -------------------------------
# Grafana es publico, en https://<DOMAIN>/grafana, y esto es lo unico que lo
# separa de cualquiera. Que sea larga y aleatoria, no una que puedas recordar.
# Prometheus, en cambio, NO se publica: no tiene autenticacion de ningun tipo y
# se llega solo por `ssh -L 9090:127.0.0.1:9090 mendri`.
GRAFANA_ADMIN_PASSWORD=
