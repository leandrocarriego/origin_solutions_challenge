# Copy to .env and fill in. None of this is versioned (SEC-01, SEC-03).

# --- Required in production--------------------------------------------------
DOMAIN=origin-solutions-challenge.mendrisoftware.com
POSTGRES_PASSWORD=

# --- The provider------------------------------------------------------------
# Empty until phase 1: the health page does not use it. The quotes module fails
# loudly the moment it needs it and it is missing (Article I: never in a VITE_*).
TWELVEDATA_API_KEY=

# --- Observability (ADR-009)-------------------------------------------------
# Empty disables Sentry, which is what local and CI want: no events, no network.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Build stamp. The deploy script fills it with the commit SHA.
VERSION=dev

# --- Observability layer 3: Grafana (ADR-009)--------------------------------
# Grafana is public, at https://<DOMAIN>/grafana, and this is the only thing
# between it and anyone. Make it long and random, not one you can remember.
# Prometheus is NOT published: it has no authentication of any kind and is
# reached only through `ssh -L 9090:127.0.0.1:9090 mendri`.
GRAFANA_ADMIN_PASSWORD=
